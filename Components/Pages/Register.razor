@page "/register"
@rendermode InteractiveServer

<PageTitle>Register</PageTitle>

<h1>Register</h1>

<EditForm class="max-w-sm" Model="model" OnValidSubmit="HandleRegister" FormName="register">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-4">
        <label class="mb-1 block text-sm font-medium">Username</label>
        <InputText class="input" @bind-Value="model.Username" />
    </div>

    <div class="mb-4">
        <label class="mb-1 block text-sm font-medium">Password</label>
        <InputText type="password" class="input" @bind-Value="model.Password" />
    </div>
    <div class="mb-4">
        <label class="mb-1 block text-sm font-medium">Confirm Password</label>
        <InputText type="password" class="input" @bind-Value="model.PasswordConfirm" />
    </div>
    <button type="submit" class="btn">Register</button>
</EditForm>

@if (error != null)
{
    <p class="mt-3 text-red-600">@error</p>
}
    
@code {
    private RegisterModel model = new();
    private string? error;

    private void HandleRegister()
    {
        // TODO: check credentials against user store
        if (model.Username == "admin" && model.Password == "password" &&model.PasswordConfirm == "password"  )
            error = null; // success: redirect or set auth state here
        else if (model.Password != model.PasswordConfirm)
            error = "Password Mismatch";
        else
            error = "Invalid username or password.";
    }

    private class RegisterModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string Username { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required]
        public string Password { get; set; } = "";
        public string PasswordConfirm { get; set; } = "";
    }
}
