@page "/login"
@rendermode InteractiveServer

<PageTitle>Login</PageTitle>

<h1>Login</h1>

<EditForm class="max-w-sm" Model="model" OnValidSubmit="HandleLogin" FormName="login">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-4">
        <label class="mb-1 block text-sm font-medium">Username</label>
        <InputText class="input" @bind-Value="model.Username" />
    </div>

    <div class="mb-4">
        <label class="mb-1 block text-sm font-medium">Password</label>
        <InputText type="password" class="input" @bind-Value="model.Password" />
    </div>

    <button type="submit" class="btn">Log in</button>
</EditForm>

@if (error != null)
{
    <p class="mt-3 text-red-600">@error</p>
}

@code {
    private LoginModel model = new();
    private string? error;

    private void HandleLogin()
    {
        // TODO: check credentials against your user store
        if (model.Username == "admin" && model.Password == "password")
            error = null; // success: redirect or set auth state here
        else
            error = "Invalid username or password.";
    }

    private class LoginModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string Username { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required]
        public string Password { get; set; } = "";
    }
}
