@inherits LayoutComponentBase

<div class="relative flex flex-col sm:flex-row">
    <div class="bg-linear-to-b from-[rgb(5,39,103)] to-[#3a0647] to-70% sm:sticky sm:top-0 sm:h-screen sm:w-62.5">
        <NavMenu />
    </div>

    <main class="flex-1">
        <div class="sticky top-0 z-10 flex h-14 items-center justify-between border-b border-[#d6d5d5] bg-[#f7f7f7] px-4 sm:justify-end sm:pl-8 sm:pr-6">
            <a class="whitespace-nowrap hover:underline" href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
        </div>

        <article class="px-4 pt-4 sm:pl-8 sm:pr-6">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
